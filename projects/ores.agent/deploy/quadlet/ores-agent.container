[Unit]
Requires=ores-agent-llama.service
After=ores-agent-llama.service

[Container]
Image=localhost/ores-agent:local
Network=ores-agent-backend.network
Network=ores-agent-inference.network
PublishPort=127.0.0.1:20100:20100
UserNS=keep-id:uid=1000,gid=1000
Volume=%h/.config/ores-agent/agent.json:/run/ores-agent/agent.json:ro,Z
Volume=%h/.config/ores-agent/nats:/run/ores-agent/nats:ro,Z
Volume=%h/.config/ores-agent/llama-api-key:/run/ores-agent/llama-api-key:ro,z
Volume=ores-agent-state.volume:/var/lib/ores-agent
ReadOnly=true
DropCapability=all
NoNewPrivileges=true
PodmanArgs=--stop-timeout=20

[Service]
Restart=on-failure
TimeoutStopSec=25

[Install]
WantedBy=default.target
